% ============================================================
%  CAPÍTULO 4 — RESULTADOS Y DISCUSIÓN
% ============================================================
\chapter{Resultados y Discusión}
\label{cap:resultados}

Este capítulo presenta los resultados organizados por experimento. Cada
sección sigue la estructura: \textbf{objetivo}, \textbf{metodología},
\textbf{resultados} y \textbf{análisis}. La base de datos oficial
comprende las sesiones S2--S7 (6 sesiones, 14\,901 ventanas).

Como punto de partida, la Figura~\ref{fig:firmas_espectrales} compara la
reflectancia de superficie media por banda ---obtenida de las imágenes
calibradas mediante el panel~CRP--- de cinco clases de ventanas antes de
entrenar ningún clasificador: \ac{MAP}, Botella, Lata, Piedra (objetos de interferencia
enterrados) y zonas de control (sin objeto). Las ventanas con \ac{MAP}
presentan mayor reflectancia en las bandas visibles ---coherente con la
reducción de cobertura vegetal sobre el suelo perturbado--- y valores
menores en NDVI y RENDVI respecto a las zonas de control, lo que confirma
la contribución discriminativa de las bandas Red Edge y \ac{NIR}.
Los objetos de interferencia muestran firmas parcialmente solapadas con la
\ac{MAP} en el espectro visible (especialmente Botella), pero con patrones
distintos en los índices NIR y Red Edge, lo que sugiere que el clasificador
puede distinguirlos a partir de esas bandas.

\begin{figure}[H]
  \centering
  \includegraphics[width=\textwidth]{figuras/firmas_espectrales_clases.png}
  \caption{Firma espectral promedio por clase de la ventana (Enfoque~B, S2--S7).
           Se muestran cinco clases: \ac{MAP} ($n$=456), Botella ($n$=345),
           Lata ($n$=316), Piedra ($n$=176) y zonas de control ($n$=4\,535).
           Las ventanas de interferencia se identificaron mediante las
           anotaciones Roboflow~V3; las ventanas de fondo dentro de la zona
           de mina se excluyen de la figura.
           \textit{Izquierda:} reflectancia media por banda espectral.
           \textit{Derecha:} índices espectrales clave.}
  \label{fig:firmas_espectrales}
\end{figure}

% -------------------------------------------------------------
\section{Evaluación del etiquetado: Enfoque A vs Enfoque B}
\label{sec:enfoque_a}
\label{sec:enfoque_b}

\textbf{Objetivo.} Evaluar el efecto de la estrategia de etiquetado sobre
el rendimiento del clasificador, comparando el etiquetado por imagen
completa (Enfoque~A) con el groundtruth segmentado mediante bounding box
(Enfoque~B), para determinar si la precisión del etiquetado afecta la
capacidad del modelo de aprender de las bandas \ac{NIR} y Red Edge.

\textbf{Metodología.} Se evaluaron dos estrategias de etiquetado sobre la
base de datos oficial S2--S7. En el \textbf{Enfoque~A}, toda la imagen de
una zona de mina recibe etiqueta positiva (etiquetado por imagen completa).
En el \textbf{Enfoque~B}, solo las ventanas cuyo centro cae dentro del
bounding box de la \ac{MAP} reciben etiqueta positiva (groundtruth
segmentado); el procedimiento de anotación se describe en la
Sección~\ref{sec:segmentacion_groundtruth} y resultó en \textbf{487 ventanas
positivas} y 14\,414 negativas (ratio 30:1), cuya distribución por sesión
se presenta en la Tabla~\ref{tab:enfoques_comparacion}, junto con los
resultados de validación \ac{LOSO}. En ambos casos se entrenó un \ac{RF}
con las 378 características disponibles.

\textbf{Resultados.}

\begin{table}[H]
\centering
\caption{Dataset (Enfoque~B) y resultados LOSO por sesión --- Enfoque A vs.\ Enfoque B (RF, S2--S7)}
\label{tab:enfoques_comparacion}
\small
\begin{tabular}{ccccccc}
\toprule
\multirow{2}{*}{\textbf{Sesión}} &
\multicolumn{3}{c}{\textbf{Dataset Enfoque B}} &
\multicolumn{3}{c}{\textbf{AUC LOSO}} \\
\cmidrule(lr){2-4}\cmidrule(lr){5-7}
 & \textbf{Pos.} & \textbf{Neg.} & \textbf{Ratio} &
   \textbf{Enf. A} & \textbf{Enf. B} & \textbf{$\Delta$AUC} \\
\midrule
S2 &  75 & 1\,869 & 25:1 & 0.920 & 0.860 & $-$0.060 \\
S3 &  84 & 2\,508 & 30:1 & 0.866 & 0.926 & $+$0.060 \\
S4 &  87 & 2\,505 & 29:1 & 0.809 & 0.900 & $+$0.091 \\
S5 &  81 & 2\,510 & 31:1 & 0.915 & 0.924 & $+$0.009 \\
S6 &  78 & 2\,512 & 32:1 & 0.884 & 0.943 & $+$0.059 \\
S7 &  82 & 2\,510 & 31:1 & 0.914 & 0.926 & $+$0.012 \\
\midrule
\textbf{Total}   & \textbf{487} & \textbf{14\,414} & \textbf{30:1} & --- & --- & --- \\
\textbf{Promedio} & --- & --- & --- & \textbf{0.885} & \textbf{0.913} & \textbf{$+$0.028} \\
\bottomrule
\end{tabular}
\end{table}

\textbf{Análisis.} El Enfoque~A alcanza AUC~=~$0.885 \pm 0.039$, lo que
confirma que las características espectrales contienen información
discriminativa incluso con etiquetado grueso. La variabilidad entre
sesiones es notable: S4 (AUC~=~0.809) presenta el resultado más bajo,
coincidiendo con la sesión de menor irradiancia solar (64.5~W/m²). Sin
embargo, ninguna de las diez características más importantes pertenece a
las bandas \ac{NIR} o Red Edge: al asignar etiqueta positiva a toda la
imagen, el clasificador aprende del contexto visible y no de la
perturbación espectral localizada.

El Enfoque~B muestra una diferencia promedio de $+$0.028 en \ac{AUC}
respecto al Enfoque~A, positiva en cinco de los seis pliegues de
validación \ac{LOSO} (Tabla~\ref{tab:enfoques_comparacion}), y reduce la
varianza de $\pm$0.039 a $\pm$0.023. El aporte principal no es la
diferencia numérica sino confirmar que las bandas \ac{NIR} y Red Edge
contienen información discriminativa cuando el etiquetado es preciso ---
efecto invisible con el Enfoque~A. La complejidad adicional recae en la
anotación manual (realizada una sola vez), no en el clasificador. La
única caída corresponde a S2 ($-$0.060), sesión con el menor número de
ventanas positivas (75 de 487) y una sola zona de control. La selección
del clasificador y las características óptimas sobre Enfoque~B se
presentan en las secciones siguientes; el modelo final
(EasyEnsemble~x10 XGBoost, top-50) alcanza \textbf{AUC~=~0.937}.

% -------------------------------------------------------------
\section{Importancia de características: Enfoque A vs Enfoque B}
\label{sec:importancia_enfoques}

\textbf{Objetivo.} Determinar el efecto de la estrategia de etiquetado
sobre qué características aprende el clasificador, usando el mismo
\ac{RF} en ambos enfoques para aislar la variable de etiquetado de
cualquier diferencia debida al clasificador.

\textbf{Metodología.} Se calculó la importancia Gini del \ac{RF}
(100 árboles, \texttt{max\_depth}=10, \texttt{class\_weight=balanced})
sobre las 378 características, promediada sobre los seis folds
\ac{LOSO} (S2--S7), para el Enfoque~A y el Enfoque~B.

\textbf{Resultados.} La Tabla~\ref{tab:importancia_rf_enfoques}
compara las top-10 características de cada enfoque.

\begin{table}[H]
\centering
\caption{Top-10 características por importancia Gini RF (LOSO, S2--S7)
         --- Enfoque A vs.\ Enfoque B}
\label{tab:importancia_rf_enfoques}
\small
\begin{tabular}{@{}cllll@{}}
\toprule
\multirow{2}{*}{\textbf{\#}} &
\multicolumn{2}{c}{\textbf{Enfoque A}} &
\multicolumn{2}{c}{\textbf{Enfoque B}} \\
\cmidrule(lr){2-3}\cmidrule(lr){4-5}
 & \textbf{Índice} & \textbf{Estadístico} &
   \textbf{Índice} & \textbf{Estadístico} \\
\midrule
1  & VARI        & median & Red              & mean     \\
2  & Red\_Blue   & p25    & SI               & std      \\
3  & VARI        & p75    & \textbf{RENDVI}  & std      \\
4  & EVI         & p25    & \textbf{NDVI}    & std      \\
5  & NDRB        & median & GRVI             & p25      \\
6  & HI          & p25    & NDSVI            & std      \\
7  & NDRB        & p25    & \textbf{NIR\_Red}& p25      \\
8  & Blue        & std    & \textbf{NDSI}    & std      \\
9  & Red\_Blue   & median & Red\_Green       & p75      \\
10 & NDRB        & p75    & CI\_soil         & skewness \\
\bottomrule
\end{tabular}
\vspace{4pt}
\par\small En negrita: índices que involucran NIR (842~nm) o Red Edge (717~nm).
\end{table}

\textbf{Análisis.} En el Enfoque~A, nueve de las diez características
principales son índices del espectro visible (VARI, NDRB, HI,
Red\_Blue); EVI en el puesto~4 es el único que involucra NIR, con
importancia individual baja (0.017). En el Enfoque~B, cuatro de las
diez primeras características involucran NIR o Red Edge: RENDVI (\#3),
NDVI (\#4), NIR\_Red (\#7) y NDSI (\#8). Además, el estadístico
\texttt{std} domina en el Enfoque~B, lo que indica que la mina genera
un gradiente espectral localizado que la desviación estándar dentro de
la ventana captura mejor que el valor medio. Estos resultados confirman
que el Enfoque~B permite al clasificador aprender la perturbación
espectral en NIR y Red Edge que el etiquetado grueso del Enfoque~A
enmascara.

% -------------------------------------------------------------
\section{Comparación de clasificadores y estrategia de desbalance}
\label{sec:comparacion_clasificadores}

\textbf{Objetivo.} Seleccionar la arquitectura de clasificación más
adecuada para el Enfoque~B y resolver el problema de baja sensibilidad
a umbral~0.5 causado por el desbalance 30:1.

\textbf{Metodología.} Antes de definir el clasificador final se compararon tres arquitecturas
sobre el Enfoque~B con las \textbf{mismas} top-100 características,
seleccionadas por \ac{RF} como experimento de línea base: \ac{RF},
XGBoost base y \ac{SVM} con kernel gaussiano (RBF\footnote{RBF:
\textit{Radial Basis Function}; equivalente al kernel gaussiano
$k(\mathbf{x},\mathbf{x'})=\exp(-\gamma\|\mathbf{x}-\mathbf{x'}\|^2)$.
Parámetros usados: $C=1.0$, $\gamma=\text{scale}=1/(p \cdot \sigma_X^2)$
con $p=100$ características; escalado por StandardScaler por fold.})
(Tabla~\ref{tab:comparacion_clsif_base}). Usar las mismas características
para los tres clasificadores garantiza que las diferencias de AUC reflejen
la arquitectura y no la selección de variables. Los tres clasificadores
usaron \texttt{class\_weight=`balanced'} para compensar el desbalance 30:1;
\ac{RF} y XGBoost con sus hiperparámetros estándar (sin tuning adicional),
y la \ac{SVM} con los parámetros indicados en la nota al pie.

\begin{table}[H]
\centering
\caption{Comparación de clasificadores --- Enfoque B, top-100 features (RF-seleccionadas
         como experimento de línea base; el modelo final usa importancia XGBoost, véase
         Sección~\ref{sec:seleccion_features}), LOSO S2--S7}
\label{tab:comparacion_clsif_base}
\small
\begin{tabular}{lc}
\toprule
\textbf{Clasificador} & \textbf{AUC} \\
\midrule
Random Forest (base)  & 0.929 $\pm$ 0.019 \\
SVM kernel gaussiano  & 0.937 $\pm$ 0.019 \\
XGBoost base          & 0.945 $\pm$ 0.016 \\
\bottomrule
\end{tabular}
\end{table}

\textbf{Resultados y análisis.} XGBoost superó a \ac{RF} en $+$0.016 AUC con menor varianza entre sesiones
(std~=~0.016). El problema es que el XGBoost base (con
\texttt{scale\_pos\_weight=30} para el desbalance 30:1) tiene una sensibilidad
de apenas 0.534 a umbral~0.5, lo que exige ajuste de Youden antes de reportar
métricas operativas. Para evitar ese ajuste se probó \textbf{EasyEnsemble~x10}:
entrenar 10 clasificadores XGBoost, cada uno con los 487 positivos más un
subconjunto distinto de 487 negativos (ratio~1:1), y promediar las diez
probabilidades. Con balance~1:1 por sub-clasificador, el umbral~0.5 recupera
su significado probabilístico sin ajuste adicional.

\begin{table}[H]
\centering
\caption{Comparación de estrategias de desbalance --- XGBoost, Enfoque~B
         (S2--S7), umbral fijo~=~0.5}
\label{tab:comparacion_estrategias}
\begin{minipage}{\textwidth}
\centering\small
\begin{tabular}{@{}lcccc@{}}
\toprule
\textbf{Estrategia} & \textbf{AUC} & \textbf{Sens(0.5)} &
\textbf{FPR} & \textbf{FP/mina} \\
\midrule
XGBoost base (scale\_pos\_weight=30)  & 0.945 & 0.534 & ---  & --- \\
XGBoost undersampling 1:1             & 0.930 & 0.817 & 0.130 & 4.7 \\
\textbf{EasyEnsemble~x10 XGBoost}     & \textbf{0.937} & \textbf{0.823} &
\textbf{0.142} & \textbf{5.1} \\
\bottomrule
\end{tabular}
\vspace{4pt}
\par\small AUC: promedio LOSO; Sens/FPR: agregado sobre todos los folds.\\
Experimento realizado con top-50 características (véase Sección~\ref{sec:seleccion_features} para la metodología de selección).
\end{minipage}
\end{table}

\textbf{EasyEnsemble~x10 XGBoost es el clasificador seleccionado}: logra
AUC~=~0.937~$\pm$~0.019 y Sens(0.5)~=~0.823 sin ajuste del umbral. Frente
al XGBoost base, gana $+$0.289 en sensibilidad cediendo solo $-$0.008 en
AUC; la diferencia práctica es que el umbral~0.5 ya no necesita calibración
para ser operativo.

% -------------------------------------------------------------
\section{Importancia y selección de características}
\label{sec:seleccion_features}

\textbf{Objetivo.} Identificar las características más discriminativas
del clasificador seleccionado (EasyEnsemble~x10 XGBoost) y determinar
el número óptimo $k$ a retener, reduciendo la dimensionalidad sin
pérdida de rendimiento.

\textbf{Metodología.} Se calculó la importancia de ganancia de XGBoost
con submuestreo~1:1, promediada sobre los seis folds \ac{LOSO}.
La importancia de ganancia cuantifica cuánto reduce cada característica
la impureza del árbol en promedio, siendo más robusta que la importancia
por permutación en presencia de características correlacionadas
\cite{breiman2001}. A continuación se barrió
$k \in \{10, 20, 50, 100, 200, 378\}$ usando esa misma importancia
para seleccionar las $k$ características de mayor valor en cada fold
(selección interna, evitando usar importancias de \ac{RF} para
alimentar a XGBoost).

\textbf{Resultados.} La Tabla~\ref{tab:feature_importance_b} presenta las
top-10 características del Enfoque~B con EasyEnsemble~x10 XGBoost; la
importancia decrece rápidamente a partir de esta posición
(Figura~\ref{fig:importancia_acumulada}).

\begin{table}[H]
\centering
\caption{Top-10 características por importancia de ganancia XGBoost (LOSO,
         undersampling 1:1) --- Enfoque B (groundtruth segmentado, S2--S7)}
\label{tab:feature_importance_b}
\begin{minipage}{\textwidth}
\centering
\begin{tabular}{@{}ccccc@{}}
\toprule
\textbf{\#} & \textbf{Índice} & \textbf{Estadístico} & \textbf{Banda(s)} & \textbf{Imp. media} \\
\midrule
1  & GRVI      & p25       & Verde/Rojo           & 0.04566 \\
2  & Red       & mean      & Rojo                 & 0.04218 \\
3  & NDSI      & p75       & \textbf{NIR}/Rojo    & 0.04008 \\
4  & NIR\_Red  & p25       & \textbf{NIR}/Rojo    & 0.03910 \\
5  & NDVI      & p25       & \textbf{NIR}/Rojo    & 0.02953 \\
6  & Red       & std       & Rojo                 & 0.02916 \\
7  & BSI       & p75       & \textbf{NIR}/Visible & 0.01889 \\
8  & CI\_soil  & p75       & Rojo/Verde           & 0.01625 \\
9  & VARI      & p25       & Visible              & 0.01541 \\
10 & NDSI      & skewness  & \textbf{NIR}/Rojo    & 0.01329 \\
\bottomrule
\end{tabular}
\vspace{4pt}
\par\small NDSI = (Rojo $-$ NIR)/(Rojo $+$ NIR); \\ BSI = $[(Rojo+Azul)-(NIR+Verde)] / [(Rojo+Azul)+(NIR+Verde)]$.
\end{minipage}
\end{table}

\textbf{Análisis.} El estadístico \texttt{std} domina en el Enfoque~B:
la desviación estándar captura el gradiente espectral localizado que
genera la mina dentro de la ventana mejor que el valor medio. NIR
aparece en los puestos 3, 4, 7 y 10 a través de NDSI, NIR\_Red, NDVI
y BSI ---coherente con el resultado de la Sección anterior
(Tabla~\ref{tab:importancia_rf_enfoques}).

\textbf{Barrido de $k$.} Se barrió
$k \in \{10, 20, 50, 100, 200, 378\}$ bajo validación \ac{LOSO}, S2--S7.
Los valores de $k$ se seleccionaron a distintas escalas: con mayor
resolución en la región de mejora rápida ($k \leq 20$) y menor donde la
curva se aplana ($k \geq 50$); la tasa de cambio en \ac{AUC} decrece
notablemente a partir de $k=50$, haciendo innecesario evaluar valores
intermedios adicionales. El \ac{AUC} es la métrica de selección del $k$
óptimo por ser independiente del umbral de decisión. Sens(0.5) denota la
sensibilidad evaluada a umbral fijo~=~0.5, el valor utilizado en el
despliegue. FP/mina es el número de falsos positivos por mina detectada
(FP/TP) a ese mismo umbral; valores mayores a~1 son esperados dado el
desbalance 30:1, y cuantifican cuántas falsas alarmas genera el sistema
por cada mina correctamente identificada.

\textbf{Resultados.}

\begin{table}[H]
\centering
\caption{Métricas con LOSO según número de características seleccionadas por XGBoost
         --- EasyEnsemble x10, Enfoque B (S2--S7)}
\label{tab:seleccion_features_b}
\begin{minipage}{\textwidth}
\centering\small
\begin{tabular}{@{}ccccc@{}}
\toprule
\textbf{$k$} & \textbf{AUC} & \textbf{Sens(0.5)} & \textbf{FPR} &
\textbf{FP/mina} \\
\midrule
10           & 0.900        & 0.807              & 0.156        & 5.7 \\
20           & 0.921        & 0.842              & 0.147        & 5.2 \\
\textbf{50}  & \textbf{0.930} & \textbf{0.840}  & \textbf{0.127} & \textbf{4.5} \\
100          & 0.935        & 0.840              & 0.121        & 4.3 \\
200          & 0.934        & 0.803              & 0.116        & 4.3 \\
378          & 0.930        & 0.815              & 0.118        & 4.3 \\
\bottomrule
\end{tabular}
\vspace{4pt}
\par\small Sens(0.5): sensibilidad a umbral de decisión~=~0.5.
FP/mina: falsos positivos por mina detectada (FP/TP); valores~$>$~1 son
esperados dado el desbalance 30:1.
Valor marcado en negrita obtenido en una ejecución independiente; la
corrida canónica del modelo final reporta Sens~=~0.823 para $k=50$
(variabilidad estocástica del submuestreo).
\end{minipage}
\end{table}

\begin{figure}[H]
  \centering
  \includegraphics[width=\textwidth]{figuras/seleccion_features_xgb.png}
  \caption{Selección de características por XGBoost + EasyEnsemble~x10
           bajo validación \ac{LOSO} (S2--S7). \textit{Izquierda:} AUC vs.\
           número de características $k$; la curva se estabiliza en $k=50$.
           \textit{Centro:} Sensibilidad a umbral~=~0.5 vs.\ $k$; entre
           $k=50$ y $k=100$ la sensibilidad es idéntica (0.840).
           \textit{Derecha:} Importancia acumulada por índice espectral
           (top-20).}
  \label{fig:seleccion_features}
\end{figure}

\textbf{Análisis.} El \textbf{punto óptimo es $k=50$}: desde ahí la curva de AUC se aplana,
y la Sens(0.5) entre $k=50$ y $k=100$ es idéntica (0.840), con $-$0.005
de diferencia en AUC (Figura~\ref{fig:seleccion_features}). Pasar de 100
a 50 características reduce el vector de entrada a la mitad sin afectar el
rendimiento. Incluso $k=10$ supera AUC~=~0.90, lo que muestra que la señal
espectral no está concentrada en unos pocos índices.

La Figura~\ref{fig:importancia_acumulada} muestra la importancia de ganancia
acumulada sobre las 378 características, promediada sobre los seis folds
\ac{LOSO}. Las top-50 suman el \textbf{42.5\,\%} de la importancia total;
a partir de $k=50$ cada característica adicional aporta menos del 0.6\,\%
de forma individual. El panel derecho muestra esa caída claramente: la
importancia por característica se vuelve casi plana pasado el rango~50.

\begin{figure}[H]
  \centering
  \includegraphics[width=\textwidth]{figuras/importancia_acumulada.png}
  \caption{Criterio técnico de selección por importancia acumulada ---
           XGBoost gain, promedio \ac{LOSO} S2--S7, submuestreo~1:1.
           \textit{Izquierda:} importancia acumulada vs.\ $k$; la línea
           roja marca $k=50$ (42.5\,\% acumulado). Las líneas de referencia
           indican los umbrales del 70\,\%, 80\,\%, 90\,\% y 95\,\%.
           \textit{Derecha:} importancia individual de las top-100
           características; la caída abrupta a partir del rango~50 confirma
           el punto de rendimientos decrecientes.}
  \label{fig:importancia_acumulada}
\end{figure}

% -------------------------------------------------------------
\section{Modelo final: métricas con LOSO por fold}
\label{sec:metricas_modelo_final}

\textbf{Objetivo.} Reportar el rendimiento del modelo final seleccionado
(EasyEnsemble~x10 XGBoost, top-50) bajo validación \ac{LOSO} completa,
con métricas operativas a umbral~=~0.5.

\textbf{Metodología.} Se evaluó el modelo sobre los seis folds \ac{LOSO}
(S2--S7) con las top-50 características seleccionadas por importancia de
ganancia XGBoost en cada fold.

\textbf{Resultados.} La Tabla~\ref{tab:loso_modelo_final} reporta las
métricas por fold a umbral~=~0.5.

\begin{table}[H]
\centering
\caption{Métricas con LOSO por fold --- Modelo final (EasyEnsemble~x10 XGBoost,
         top-50, Enfoque~B, S2--S7, umbral~=~0.5)}
\label{tab:loso_modelo_final}
\begin{minipage}{\textwidth}
\centering\small
\begin{tabular}{@{}lccccccccc@{}}
\toprule
\textbf{Fold} & \textbf{AUC} & \textbf{Sens} & \textbf{Spec} &
\textbf{FPR} & \textbf{TP} & \textbf{FN} & \textbf{FP} & \textbf{TN} \\
\midrule
S2 & 0.902 & 0.827 & 0.836 & 0.164 &  62 & 13 &  307 & 1\,562 \\
S3 & 0.927 & 0.952 & 0.592 & 0.408 &  80 &  4 & 1\,023 & 1\,485 \\
S4 & 0.937 & 0.793 & 0.902 & 0.098 &  69 & 18 &  245 & 2\,260 \\
S5 & 0.943 & 0.815 & 0.912 & 0.088 &  66 & 15 &  220 & 2\,290 \\
S6 & 0.959 & 0.846 & 0.934 & 0.066 &  66 & 12 &  165 & 2\,347 \\
S7 & 0.952 & 0.707 & 0.967 & 0.033 &  58 & 24 &   82 & 2\,428 \\
\midrule
\textbf{Prom.} & \textbf{0.937} & \textbf{0.823} & \textbf{0.857} &
\textbf{0.143} & \textbf{401} & \textbf{86} & \textbf{2\,042} &
\textbf{12\,372} \\
Std & 0.019 & 0.080 & 0.138 & 0.138 & & & & \\
\bottomrule
\end{tabular}
\vspace{4pt}
\par\small Sens~=~sensibilidad; Spec~=~especificidad; FPR~=~tasa de falsos positivos.\\
Fila Prom.: AUC/Sens/Spec/FPR son medias por fold; TP/FN/FP/TN son sumas acumuladas de los seis folds. $\sim$5.1~FP por mina detectada.
\end{minipage}
\end{table}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.62\textwidth]{figuras/matriz_confusion_final.png}
  \caption{Matriz de confusión del modelo final (EasyEnsemble x10
           XGBoost, top-50, umbral~=~0.5), acumulando los seis folds
           \ac{LOSO} (S2--S7). Los conteos se muestran con submuestreo
           balanceado 1:1 (487 negativos de 14\,414) para facilitar la
           comparación visual entre clases; los porcentajes corresponden
           a la distribución real: sensibilidad~=~82.3\,\% y
           especificidad~=~85.8\,\% (véase Tabla~\ref{tab:loso_modelo_final}).}
  \label{fig:matriz_confusion}
\end{figure}

\textbf{Análisis.} La sesión~S3 destaca por su alta sensibilidad (0.952, solo 4~FN) pero baja
especificidad (0.592), lo que genera 1\,023 falsos positivos cuando S3 es el
fold de prueba. Esto indica que el modelo entrenado sin S3 no generaliza
completamente a las condiciones de esa sesión ---posiblemente por condiciones
de captura específicas de ese día---. S7 presenta el patrón contrario: alta
especificidad (0.967) pero la sensibilidad más baja (0.707, 24~FN), sugiriendo
que las condiciones de S7 dificultan la detección de algunas minas. Los folds
S5 y S6 muestran el balance más favorable (Sens~$>$~0.81, Spec~$>$~0.91).

La Figura~\ref{fig:mapa_probabilidades} ilustra espacialmente el
funcionamiento del modelo sobre una imagen real: la región de alta
probabilidad coincide con la zona anotada como \ac{MAP}, confirmando
que el sistema localiza la perturbación espectral y no produce detecciones
aleatorias distribuidas uniformemente en la imagen.

\begin{figure}[H]
  \centering
  \includegraphics[width=\textwidth]{figuras/mapa_probabilidades.png}
  \caption{Mapa de probabilidades del modelo final (EasyEnsemble x10
           XGBoost, top-50, umbral~=~0.5) sobre la imagen de la
           Sesión~S5, zona \texttt{MINA\_3CM\_1}. \textit{Izquierda:}
           imagen RGB calibrada con el bounding box de la \ac{MAP}
           (línea verde discontinua). \textit{Derecha:} probabilidad
           de \ac{MAP} superpuesta en escala de color; azul~=~baja
           probabilidad, rojo~=~alta probabilidad. El modelo detecta
           9 de 12 ventanas positivas (TP=9, FN=3) con 33 falsas
           alarmas fuera de la región anotada.}
  \label{fig:mapa_probabilidades}
\end{figure}

